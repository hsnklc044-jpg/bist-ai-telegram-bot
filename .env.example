# Telegram bot token (BotFather)
BOT_TOKEN=
# Botu kullanmasına izin verilen Telegram chat id
CHAT_ID=
# İsteğe bağlı: yalnız bu Telegram kullanıcı ID'sinden gelen komutlar işlenir (boşsa CHAT_ID; özel sohbette ikisi aynıdır)
USER_ID=
# Sadece sunucuda: bot günlük raporu hafta içi bu saatte (İstanbul) kendisi gönderir.
# Windows'ta zamanlanmış görev kullanıyorsanız boş bırakın, yoksa rapor iki kez gelir.
DAILY_REPORT_AT=
# Kişisel kayıtların yedek klasörü (boşsa data\backups). Disk arızasına karşı
# senkronize bir klasör önerilir, ör. C:\Users\<ad>\OneDrive\QuantBIST-yedek
# Sunucuda (Docker): /app/backups; PC'ye alma: scripts\pull_backups.ps1 (docs/SERVER.md)
BACKUP_DIR=
# Dışarıdan izleme (Healthchecks.io, isteğe bağlı; adımlar docs/OPERATIONS.md §7).
# Bu adresler gizlidir: kimseyle paylaşmayın, GitHub'a koymayın. Boşsa hiçbir şey gönderilmez.
HC_REPORT_URL=
HC_BOT_URL=

# Lisanslı fiyat kaynağı (isteğe bağlı; J madde 4, docs/DATA_SOURCES.md). Adaptörü yazılmış bir kaynağın adı ve anahtarı.
# QUANTBIST_PRICE_SOURCE=
# QUANTBIST_PRICE_SOURCE_KEY=
