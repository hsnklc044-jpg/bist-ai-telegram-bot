# Telegram bot token (BotFather)
BOT_TOKEN=
# Botu kullanmasına izin verilen Telegram chat id
CHAT_ID=
# Sadece sunucuda: bot günlük raporu hafta içi bu saatte (İstanbul) kendisi gönderir.
# Windows'ta zamanlanmış görev kullanıyorsanız boş bırakın, yoksa rapor iki kez gelir.
DAILY_REPORT_AT=
# Kişisel kayıtların yedek klasörü (boşsa data\backups). Disk arızasına karşı
# senkronize bir klasör önerilir, ör. C:\Users\<ad>\OneDrive\QuantBIST-yedek
# Sunucuda (Docker): /app/backups; PC'ye alma: scripts\pull_backups.ps1 (docs/SERVER.md)
BACKUP_DIR=
